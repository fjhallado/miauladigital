{"title": "Tablas HTML", "html": "<h1>Catálogo de productos</h1>\n<table>\n <caption>Productos disponibles</caption>\n <thead><tr><th>Producto</th><th>Precio</th><th>Stock</th></tr></thead>\n <tbody>\n  <tr><td>Portátil</td><td>650 €</td><td>12</td></tr>\n  <tr><td>Ratón</td><td>25 €</td><td>30</td></tr>\n  <tr><td>Teclado</td><td>45 €</td><td>18</td></tr>\n </tbody>\n</table>", "css": "body{font-family:Arial,sans-serif;padding:22px} table{width:90%;border-collapse:collapse;margin:20px auto} th{background:#234567;color:white;padding:12px} td{border:1px solid gray;padding:10px;text-align:center} tr:nth-child(even){background:#eeeeee}"}