{"title": "CSS: estilos y diseño", "html": "<header><h1>Mi sitio web</h1></header>\n<main><section class=\"tarjeta\"><h2>Hola, CSS</h2><p>Probamos estilos.</p><button>Explorar</button></section></main>", "css": "body{font-family:Arial,sans-serif;background:#edf4ff;margin:0;color:#173453}header{background:#17365e;color:white;padding:22px}main{padding:24px}.tarjeta{background:white;border:1px solid #c6d5ef;border-radius:16px;padding:24px;max-width:420px;box-shadow:0 9px 20px #112b4522}button{background:#225da3;color:white;border:0;padding:10px 20px;border-radius:8px}"}