{"title": "Formularios HTML", "html": "<h1>Contacto</h1>\n<form>\n <label for=\"nombre\">Nombre</label>\n <input type=\"text\" id=\"nombre\" name=\"nombre\" required>\n <label for=\"correo\">Correo electrónico</label>\n <input type=\"email\" id=\"correo\" name=\"correo\">\n <label for=\"consulta\">Consulta</label>\n <textarea id=\"consulta\" name=\"consulta\"></textarea>\n <label for=\"curso\">Curso</label>\n <select id=\"curso\" name=\"curso\"><option>1.º Bachillerato</option><option>2.º Bachillerato</option></select>\n <button type=\"submit\">Enviar</button>\n</form>", "css": "body{font-family:Arial,sans-serif;padding:20px}form{max-width:420px;display:grid;gap:10px}label{font-weight:bold}input,textarea,select{padding:9px;border:1px solid #aaa;border-radius:5px}button{padding:10px;background:#245a9c;color:white;border:0}"}